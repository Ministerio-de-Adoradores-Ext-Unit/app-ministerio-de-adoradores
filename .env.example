# Opcional: copie para .env.local apenas se quiser usar outro projeto Supabase.
# O .env versionado já fornece a configuração pública padrão para toda a equipe.
# Nunca coloque senha do banco, service_role ou chave secreta neste arquivo.
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica
