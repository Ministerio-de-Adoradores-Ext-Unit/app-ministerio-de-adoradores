{
  "expo": {
    "name": "app-extensao-universitaria",
    "slug": "app-extensao-universitaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/logoImagem.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/logoImagem.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.appextensaouniversitaria"
    },
    "web": {
      "favicon": "./assets/img/logoImagem.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Permita que o app acesse suas fotos.",
          "savePhotosPermission": "Permita que o app salve fotos na galeria."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-splash-screen"
    ]
  }
}
